{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "src/**/*",
      "prisma/**/*",
      "public/**/*",
      "package.json",
      "package-lock.json",
      "railway.json",
      "next.config.js",
      "postcss.config.js",
      "tailwind.config.*",
      "tsconfig*.json",
      "scripts/**/*",
      "railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "npm start",
    "numReplicas": 2,
    "restartPolicyMaxRetries": 5,
    "restartPolicyType": "ALWAYS",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300
  }
}
